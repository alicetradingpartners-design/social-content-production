# Copy to .env and fill in. Never commit .env.

# --- Claude (pattern-card extraction) ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, more tokens)
EXTRACTION_EFFORT=high

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key (Settings -> API). Server-side only: it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# local    = frames stay in OUTPUT_DIR, frames.storage_path is the local path
# supabase = frames are uploaded to the Storage bucket below (create it first)
FRAME_STORAGE=local
SUPABASE_FRAMES_BUCKET=frames

# --- Frames ---
FRAME_FPS=1
# Long edge of extracted JPEGs, in px
FRAME_MAX_EDGE=1280
# Max frames sent to Claude per video (all frames in the first 3s + an even spread)
MAX_LLM_FRAMES=40
# ffmpeg scene-change score for hard-cut detection (lower = more sensitive)
SCENE_CUT_THRESHOLD=0.3

# --- Transcription ---
# local (faster-whisper) | openai (Whisper API) | none
TRANSCRIBE_BACKEND=local
# tiny | base | small | medium | large-v3   (local only)
WHISPER_MODEL=small
# Optional ISO code (e.g. en) - leave blank to auto-detect
WHISPER_LANGUAGE=
# Only for TRANSCRIBE_BACKEND=openai
OPENAI_API_KEY=

# --- Misc ---
VIDEO_SOURCE=manual_upload
OUTPUT_DIR=./output
